# ===== PROD-конфігурація. НЕ комітьте реальні значення! =====
# На сервері краще задавати змінні через оточення (systemd/Docker/хостинг),
# а не файлом. Реальні змінні оточення мають пріоритет над .env.
DJANGO_ENV=prod
DJANGO_SECRET_KEY=<згенеруйте: python -c "import secrets; print(secrets.token_urlsafe(50))">
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=api.example.com
DJANGO_HTTPS_ONLY=true
LOG_LEVEL=INFO

DB_ENGINE=postgres
DB_NAME=tasktracker
DB_USER=tasktracker
DB_PASSWORD=<секрет>
DB_HOST=db.example.com
DB_PORT=5432
DB_CONN_MAX_AGE=60

BACKGROUND_WORKERS=4
BACKGROUND_RUN_SYNC=false
REPORT_STEP_DELAY_SECONDS=0

EXTERNAL_API_BASE_URL=https://date.nager.at/api/v3
EXTERNAL_API_CONNECT_TIMEOUT=3
EXTERNAL_API_READ_TIMEOUT=5
EXTERNAL_API_RETRIES=2
EXTERNAL_API_BACKOFF=0.5
EXTERNAL_CACHE_TTL=3600
EXTERNAL_STALE_TTL=86400
HOLIDAYS_DEFAULT_COUNTRY=UA
