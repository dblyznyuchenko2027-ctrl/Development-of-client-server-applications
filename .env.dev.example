# ===== DEV-конфігурація. Скопіюйте у файл .env (він у .gitignore) =====
DJANGO_ENV=dev
DJANGO_SECRET_KEY=dev-only-insecure-key
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
LOG_LEVEL=DEBUG

# База даних: sqlite (за замовчуванням) або postgres
DB_ENGINE=sqlite
SQLITE_PATH=db.sqlite3
# DB_ENGINE=postgres
# DB_NAME=tasktracker
# DB_USER=tasktracker
# DB_PASSWORD=change-me
# DB_HOST=localhost
# DB_PORT=5432

# Фонові задачі (без брокера: ThreadPoolExecutor усередині застосунку)
BACKGROUND_WORKERS=2
BACKGROUND_RUN_SYNC=false
# Штучна затримка, щоб на демо було видно, що відповідь HTTP не блокується
REPORT_STEP_DELAY_SECONDS=5

# Зовнішній REST-сервіс (Nager.Date — публічні свята, без ключа)
EXTERNAL_API_BASE_URL=https://date.nager.at/api/v3
EXTERNAL_API_CONNECT_TIMEOUT=3
EXTERNAL_API_READ_TIMEOUT=5
EXTERNAL_API_RETRIES=2
EXTERNAL_API_BACKOFF=0.5
EXTERNAL_CACHE_TTL=3600
EXTERNAL_STALE_TTL=86400
HOLIDAYS_DEFAULT_COUNTRY=UA
